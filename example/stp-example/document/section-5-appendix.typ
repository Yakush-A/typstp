= Заголовок шестого раздела \ продолжение заголовка шестого раздела

Пример оформления таблицы в тексте между абзацами. Основные
технико-экономические показатели приведены в таблице @table61.

#figure(
  caption:[
    Название таблицы первая строка (выравнивание по левому краю)
    вторая строка продолжение названия
  ],

  table(
    columns:(33%, 20%, 20%, 1fr),
    rows: auto,
    table.cell(inset:(top:2em,bottom:1.1em, x:2em))[Наименование показателя], [], [], [],

    [
      1 Текст текст текст текст текст текст текст текст текст текст
    ], [], [], [],

    [
      2 Текст текст текст текст текст текст текст
    ], [], [], [],

    [
      3 Текст
    ], [], [], [],

    table.cell(colspan:4)[
      // Чтобы текст начинался с красной строки
      #par(
        [
          Примечание -- текст текст текст текст текст текст текст текст текст 
          текст текст текст текст текст текст.
        ]
      )
    ]

  ),
) <table61>


