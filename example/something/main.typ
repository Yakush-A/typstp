// Импорт пакета
#import "@preview/typo-stp:0.2.1": *

// Установка СТП-шных стилей для элементов
#show: template

// Содержание (в принципе, ничего для работы не требуется)
#outline()

// Какой-то документ
#include "example.typ"


// Экспериментальная библиография
// больше про нее рассказано в example/bibliography
#bibliography("sources.yml")


// Приложение
#appendix(
  // Обязательное/рекомендуемое/справочное
  "обязательное",
  // Название приложения
  "Секретный DeepSeek API"
)
// Содержимое приложения
#include "appendix.typ"


// Еще одно приложение
#appendix(
  "обязательное",
  "Листинг кода"
) <code-listing>
// На приложения наконец-то можно ссылаться
// условно на это приложение через @code-listing
// либо с указанием supplement'а: @code-listing[приложении] 


// Функция листинга содержимого файла 
//
// Я сам не знаю как правильно эти листинги
// оформлять, это сделано методом проб и ошибок 
#source-text(
  // path - путь к файлу 
  //
  // ОБЯЗАТЕЛЬНО НУЖНО ПИСАТЬ path("путь")
  // т.к. в ином случае Typst будет считать 
  // путь от пакета, что Вам явно не нужно
  path("appendix.typ"),

  // Отображаемое название в документе
  "appendix.typ",
)
// Еще один листинг, но тут отображаемое 
// название отличается от реального названия файла
#source-text(
  path("main.typ"),
  "main",
)

// Просто еще пару приложений 

#appendix(
  "рекомендуемое",
  "Самый секретный DeepSeek API"
)
#include "appendix.typ"

#appendix(
  "справочное",
  "Наиболее секретный DeepSeek API, никто вообще не в курсе, что это"
)
#include "appendix.typ"

