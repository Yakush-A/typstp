% ГОСТ 7.1-2003 в Typst: BibLaTeX, примеры и крайние случаи.
% Стиль: gost-7-1-2003-typst.csl (или ...-typst-grid.csl).
% В документе добавьте:  #show ".. –": ". –"
%
% НЕ ПОДДЕРЖИВАЕТСЯ в .bib (используйте Hayagriva .yml):
%  - 4+ авторов без заголовка записи и коллективный автор: нет поля, дающего «collaborator»;
%    автор из author всегда становится заголовком записи.
%  - «В 2 т.» (поле volumes не передаётся).
%  - Газета с датой: «5 марта» теряется, остаётся только год.
%  - «[Электронный ресурс]» для @software и @book: пишите в title вручную.

% --- 1. Один автор. Место сразу в сокращённом виде; pagetotal -> «288 с.»
@book{guk, author={Гук, Михаил}, title={Процессоры Pentium II, Pentium Pro и просто Pentium},
  location={СПб.}, publisher={Питер Ком}, year={1999}, pagetotal={288}}

% --- 2. Три автора. Сведения после « : » — в поле type (вид издания строчными)
@book{kuz, author={Кузелин, Михаил Олегович and Кнышев, Дмитрий Александрович and Зотов, Валерий Юрьевич},
  title={Современные семейства ПЛИС фирмы Xilinx}, type={справ. пособие},
  location={М.}, publisher={Горячая линия – Телеком}, year={2004}, pagetotal={440}}

% --- 3. Четыре автора: заголовок записи появится (ограничение .bib)
@book{klu, author={Клюев, В. В. and Иванов, И. И. and Петров, П. П. and Сидоров, С. С.},
  title={Технические средства диагностирования}, type={справочник},
  location={М.}, publisher={Машиностроение}, year={1989}, pagetotal={672}}

% --- 4. Без места издательства, но с издательством -> «[Б. м.]»; издание числом -> «2-е изд.»
@book{edition-num, author={Иванов, Иван Петрович}, title={Основы теории}, edition={2},
  publisher={Наука}, year={2010}, pagetotal={300}}

% --- 5. Издание строкой выводится как есть
@book{edition-str, author={Иванов, Иван Петрович}, title={Основы теории},
  edition={2-е изд., перераб. и доп.}, location={М.}, publisher={Наука}, year={2010}}

% --- 6. Редактор без автора; фамилия в РОДИТЕЛЬНОМ падеже -> «под ред. В. А. Шахнова»
%        Номер тома: volume -> «Т. 1» (volumes не работает)
@book{shahnov, editor={Шахнова, В. А.}, title={Микропроцессоры и микропроцессорные комплекты интегральных микросхем},
  type={справочник. В 2 т.}, volume={1}, location={М.}, publisher={Радио и связь}, year={1988}, pagetotal={368}}
% ↑ «В 2 т.» вписано в type вручную, т.к. volumes не передаётся

% --- 7. Переводчик, родительный падеж -> «пер. А. Б. Петрова»
@book{translated, author={Керниган, Брайан}, translator={Петрова, А. Б.},
  title={Язык программирования}, location={М.}, publisher={Вильямс}, year={2015}}

% --- 8. Статья в журнале: том, номер, страницы (-- -> «–»)
@article{berski, author={Берски, Д.}, title={Набор ЭСЛ-микросхем для быстродействующего RISC-процессора},
  journaltitle={Электроника}, year={1989}, number={12}, pages={21--25}}
@article{journal-volume, author={Лис, А. А.}, title={Статья с томом},
  journaltitle={Вестник}, year={2012}, volume={5}, number={3}, pages={10--20}}

% --- 9. Статья в сборнике: название сборника целиком в booktitle, редактор -> «отв. ред.»
@inproceedings{aksenov, author={Аксенов, О. Ю.}, title={Методика формирования обучающих выборок для распознающей системы},
  booktitle={VI Всероссийская науч.-техн. конференция «Нейроинформатика-2004» : сб. науч. тр. В 2 ч.},
  editor={Мишулина, О. А.}, location={М.}, publisher={МИФИ}, year={2004}, pages={215--222}}

% --- 10. Сайт: «[Электронный ресурс]» и «Режим доступа» автоматически (@online)
@online{xilinx, title={Xilinx}, url={http://www.plis.ru/}}

% --- 11. Файл с сведениями после заглавия (type)
@online{datasheet, title={Mobile Intel® Pentium® Processor-M}, type={Datasheet},
  url={http://www.intel.com/25068604.pdf}}

% --- 12. Компакт-диск: @software не ставит метку сам -> пишем её в title; объём в note
@software{nokia, title={Nokia+Компьютер [Электронный ресурс]},
  type={инструкции, программы, драйверы, игры, мелодии, картинки для Nokia},
  location={М.}, year={2004}, note={1 компакт-диск (CD-R)}}

% --- 13. Электронная книга: метка вручную в title, url -> «Режим доступа»
@book{ebook, author={Сидоров, С. С.}, title={Учебник по Typst [Электронный ресурс]},
  location={М.}, publisher={Наука}, year={2024}, url={https://example.com/book.pdf}}
